<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.mathwhiz.model.GameResult" %><% GameResult result=(GameResult)request.getAttribute("result");if(result==null){response.sendRedirect(request.getContextPath()+"/index.jsp");return;} %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Game Result</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><main class="container">
<section class="hero result-hero"><span class="eyebrow">CHALLENGE COMPLETE</span><h1>Well played, <%=result.getPlayerName()%>!</h1><p>Your final score</p><div class="score"><%=result.getScore()%><small> / 10</small></div></section>
<section class="panel"><h2>Answer review</h2><ul class="feedback"><%for(String line:result.getFeedback()){%><li><%=line%></li><%}%></ul><div class="actions"><a class="button" href="${pageContext.request.contextPath}/index.jsp">Play Again</a><a class="button secondary" href="${pageContext.request.contextPath}/leaderboard">Leaderboard</a></div></section></main></body></html>
